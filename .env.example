# Local development: run `pnpm dev:local`. It needs no .env file, starts a throwaway Redis on port 6390 and
# logs you in to /admin with user "admin" and password "local-admin".
#
# Only if you use plain `pnpm dev` or deploy: copy this file to .env.local and replace EVERY placeholder
# below. The app rejects the placeholders on purpose (admin login stays disabled until they are changed).

# Redis Connection
# Never point a local .env.local at the production Redis: admin changes and backups are written to it.
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://default:password@localhost:6379
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT

# Secret that signs the admin login cookie. Generate one: openssl rand -base64 48
# In production the admin refuses to log in without it.
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Admin credentials, used by HTTP Basic Auth in proxy.ts. Choose a long random password.
AUTH_USERNAME=admin
AUTH_PASSWORD=your_admin_password_here

# Optional deployment override outside Vercel for sitemap/robots decisions
# SITE_ENV=production
